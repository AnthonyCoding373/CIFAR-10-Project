    "\n",
    "def tuning_lr(learning_rate: float, num_epochs: int, training_data: DataLoader, true_data: DataLoader, regularization_rate = 0):\n",
    "\n",
    "    log_reg_model = LogisticRegression(32 * 32 * 3, 10)\n",
    "    lr_learning_rate = learning_rate\n",
    "    lr_loss_func = nn.CrossEntropyLoss()\n",
    "    lr_optimizer = torch.optim.SGD(log_reg_model.parameters(), lr = lr_learning_rate, weight_decay = regularization_rate)\n",
    "\n",
    "    lr_num_epochs = num_epochs \n",
    "\n",
    "    for epoch in range(lr_num_epochs):\n",
    "        running_loss = 0.0\n",
    "        for inputs, labels in training_data:\n",
    "            lr_optimizer.zero_grad()\n",
    "\n",
    "            outputs = log_reg_model(inputs.view(-1, 32*32*3))\n",
    "            loss = lr_loss_func(outputs, labels)\n",
    "\n",
    "            loss.backward()\n",
    "            lr_optimizer.step()\n",
    "\n",
    "            running_loss += loss.item()\n",
    "\n",
    "        if (epoch % 20 == 0):\n",
    "            print(f'Epoch: {epoch}, loss = {loss.item():.4f}')\n",
    "\n",
    "    \n",
    "    correct = 0\n",
    "    total = 0\n",
    "    with torch.no_grad():\n",
    "        for inputs, labels in training_data:\n",
    "            y_probs = log_reg_model(inputs.view(-1, 32*32*3))  \n",
    "            _, y_predicted = torch.max(y_probs.data, 1)\n",
    "            total += labels.size(0)\n",
    "            correct += (y_predicted == labels).sum().item()\n",
    "\n",
    "    correct1 = 0\n",
    "    total1 = 0\n",
    "    with torch.no_grad():\n",
    "        for inputs, labels in true_data:\n",
    "            y_probs = log_reg_model(inputs.view(-1, 32*32*3))  \n",
    "            _, y_predicted = torch.max(y_probs.data, 1)\n",
    "            total1 += labels.size(0)\n",
    "            correct1 += (y_predicted == labels).sum().item()\n",
    "\n",
    "    return correct / total, correct1 / total1"
   ]
