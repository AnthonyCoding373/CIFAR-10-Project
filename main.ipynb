    "        super(LogisticRegression, self).__init__()\n",
    "        self.linear = nn.Linear(n_input_features, n_classes)\n",
    "\n",
    "    def forward(self, x):\n",
    "        y_hat = torch.sigmoid(self.linear(x))\n",
